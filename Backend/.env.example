# Copy this file to ".env" and fill in your values. Never share or upload ".env".

# Applications are ALWAYS saved to the database (db.sqlite3).
# Emails are optional. Keep this false until you have a Gmail App Password.
EMAIL_ENABLED=false

# "smtp"    = send real email through Gmail
# "console" = just print the email in the terminal (safe way to test first)
EMAIL_MODE=console

# Gmail needs an App Password: Google Account > Security > 2-Step Verification > App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Where applications are delivered
MAIL_TO=yourname@gmail.com
